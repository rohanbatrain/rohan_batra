# Auto-generated .envrc — loads the TypeScript devShell.
# Prefer a local flake if present, otherwise fall back to the public GitHub flake.
# This keeps the file portable for collaborators.

if [ -f ../nix-config/flake.nix ]; then
  use flake ../nix-config#typescript
elif [ -f ./flake.nix ]; then
  use flake ./#typescript
else
  use flake github:rohanbatrain/nix-config#typescript
fi

# Optional project-specific variables can go here
# export NODE_ENV=development
