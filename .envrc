# Prefer local flake for speed and iteration.
if [ -d "$HOME/Documents/nix-config" ]; then
  use flake "$HOME/Documents/nix-config#typescript"
# Else try to use the pinned GitHub commit we just pushed so collaborators can use it.
elif use flake "github:rohanbatrain/nix-config/a9cfc73bb234f92fe4f669b51d1c45f400cc43e6#typescript" 2>/dev/null; then
  # nothing
else
  # Fallback: try the latest GitHub ref (may be cached) — if this fails, please check the flake
  use flake "github:rohanbatrain/nix-config#typescript"
fi
